# Voorbeeld voor een eigen server met Caddy (automatische HTTPS). Zet de inhoud van dist/ in /var/www/alternatievengids.
# LET OP: setup-vps.sh in sovereignos overschrijft de Caddyfile van de scan-server. Voeg deze site daar eerst
# aan het script toe, anders verdwijnt hij bij de volgende installatie.

www.alternatievengids.nl {
	redir https://alternatievengids.nl{uri} permanent
}

alternatievengids.nl {
	root * /var/www/alternatievengids
	encode zstd gzip
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		# Verzoeken naar een serie: geen server-logs in Caddy aanzetten zonder de privacyverklaring aan te passen.
	}
	@versioned path /css/* /js/* /assets/fonts/*
	header @versioned Cache-Control "public, max-age=31536000, immutable"
	@fresh path *.html / /*/ *.json *.txt *.xml
	header @fresh Cache-Control "no-cache"
}
